{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TryDotAtwo/cayleypy-beam-results/schema/cayleypy_results_schema_v1.json",
  "title": "CayleyPy Result Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "submission_id", "idempotency_key", "author", "kaggle",
    "proof_bundle", "solution", "profile", "model", "hardware", "timings",
    "solver_commit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotency_key": {"$ref": "#/$defs/sha256"},
    "author": {"type": "string", "minLength": 1, "maxLength": 256},
    "kaggle": {"$ref": "#/$defs/kaggle"},
    "proof_bundle": {"$ref": "#/$defs/proof_bundle"},
    "solution": {"$ref": "#/$defs/solution"},
    "profile": {"$ref": "#/$defs/profile"},
    "model": {"$ref": "#/$defs/model"},
    "hardware": {"$ref": "#/$defs/hardware"},
    "timings": {"$ref": "#/$defs/timings"},
    "solver_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive_integer": {"type": "integer", "minimum": 1},
    "kaggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_slug", "kernel_version", "notebook_sha256"],
      "properties": {
        "kernel_slug": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 256
        },
        "kernel_version": {"$ref": "#/$defs/positive_integer"},
        "notebook_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proof_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_valid", "initial_state_sha256", "target_state_sha256",
        "reached_state_sha256", "generators_sha256"
      ],
      "properties": {
        "path_valid": {"const": true},
        "initial_state_sha256": {"$ref": "#/$defs/sha256"},
        "target_state_sha256": {"$ref": "#/$defs/sha256"},
        "reached_state_sha256": {"$ref": "#/$defs/sha256"},
        "generators_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "puzzle_id", "path", "move_count", "found_depth", "touch_depth",
        "variant", "valid"
      ],
      "properties": {
        "puzzle_id": {"type": "integer", "minimum": 0},
        "path": {"type": "string", "maxLength": 262144},
        "move_count": {"type": "integer", "minimum": 0},
        "found_depth": {"type": "integer", "minimum": 0},
        "touch_depth": {"type": "integer", "minimum": 0},
        "variant": {"enum": ["original", "reflected", "source"]},
        "valid": {"const": true},
        "source_solution_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b_micro", "stream1_concurrency", "stream3_ring_slots", "shard_count",
        "shard_capacity_scale_ppm", "stream4_batch_candidates",
        "stream4_trigger_candidates", "stream4_active_sort_slots"
      ],
      "properties": {
        "b_micro": {"$ref": "#/$defs/positive_integer"},
        "stream1_concurrency": {"$ref": "#/$defs/positive_integer"},
        "stream3_ring_slots": {"$ref": "#/$defs/positive_integer"},
        "shard_count": {"$ref": "#/$defs/positive_integer"},
        "shard_capacity_scale_ppm": {"$ref": "#/$defs/positive_integer"},
        "stream4_batch_candidates": {"$ref": "#/$defs/positive_integer"},
        "stream4_trigger_candidates": {"$ref": "#/$defs/positive_integer"},
        "stream4_active_sort_slots": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_evidence_version", "profile_power", "model_class",
        "requested_beam", "effective_beam", "world_size", "runtime"
      ],
      "properties": {
        "profile_evidence_version": {"$ref": "#/$defs/positive_integer"},
        "profile_power": {"$ref": "#/$defs/positive_integer"},
        "model_class": {"enum": ["output1", "output_move_count"]},
        "requested_beam": {"$ref": "#/$defs/positive_integer"},
        "effective_beam": {"$ref": "#/$defs/positive_integer"},
        "world_size": {"const": 2},
        "runtime": {"$ref": "#/$defs/runtime"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_len", "num_classes", "hd1", "hd2", "nrd", "output_dim",
        "dtype", "normalization", "layout"
      ],
      "properties": {
        "state_len": {"$ref": "#/$defs/positive_integer"},
        "num_classes": {"$ref": "#/$defs/positive_integer"},
        "hd1": {"$ref": "#/$defs/positive_integer"},
        "hd2": {"$ref": "#/$defs/positive_integer"},
        "nrd": {"$ref": "#/$defs/positive_integer"},
        "output_dim": {"$ref": "#/$defs/positive_integer"},
        "dtype": {"const": "fp16"},
        "normalization": {"enum": ["batchnorm_folded", "layernorm"]},
        "layout": {"type": "string", "minLength": 1, "maxLength": 256},
        "batchnorm": {"type": "string", "maxLength": 256},
        "embeddingbag": {"type": "string", "maxLength": 256},
        "embedding": {"type": "string", "maxLength": 256}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_sha256", "manifest"],
      "properties": {
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "manifest": {"$ref": "#/$defs/manifest"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "accelerator", "accelerator_count", "world_size"],
      "properties": {
        "platform": {"type": "string", "minLength": 1, "maxLength": 128},
        "accelerator": {"type": "string", "minLength": 1, "maxLength": 128},
        "accelerator_count": {"$ref": "#/$defs/positive_integer"},
        "world_size": {"const": 2}
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solve_seconds", "wall_seconds"],
      "properties": {
        "solve_seconds": {"type": "number", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
