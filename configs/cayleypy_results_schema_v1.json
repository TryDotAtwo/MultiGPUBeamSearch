{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trydotatwo.github.io/cayleypy-results/result-batch-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "results": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/result" } }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "submission_id", "run_id", "idempotency_key", "author", "kaggle", "competition", "puzzle_type", "puzzle_id", "proof", "orientation", "solution", "profile", "runtime", "model", "hardware", "solver_commit", "submitted_at"],
      "properties": {
        "schema_version": { "const": 1 }, "submission_id": { "type": "string", "format": "uuid" }, "run_id": { "$ref": "#/$defs/identifier" }, "idempotency_key": { "$ref": "#/$defs/sha256" },
        "author": { "type": "object", "additionalProperties": false, "required": ["name", "verification"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "kaggle_username": { "type": "string", "maxLength": 128 }, "verification": { "const": "claimed" } } },
        "kaggle": { "type": "object", "additionalProperties": false, "required": ["owner", "slug", "version"], "properties": { "owner": { "$ref": "#/$defs/identifier" }, "slug": { "$ref": "#/$defs/identifier" }, "version": { "type": "integer", "minimum": 1 }, "run_url": { "type": "string", "maxLength": 2048, "format": "uri" } } },
        "competition": { "$ref": "#/$defs/identifier" }, "puzzle_type": { "$ref": "#/$defs/identifier" }, "puzzle_id": { "type": "integer", "minimum": 0 },
        "proof": { "type": "object", "additionalProperties": false, "required": ["initial_state", "central_state", "generators"], "properties": { "initial_state": { "$ref": "#/$defs/state" }, "central_state": { "$ref": "#/$defs/state" }, "generators": { "type": "object", "minProperties": 1, "maxProperties": 256, "additionalProperties": { "$ref": "#/$defs/state" }, "propertyNames": { "$ref": "#/$defs/identifier" } } } },
        "orientation": { "type": "object", "additionalProperties": false, "required": ["search_mode", "final_orientation"], "properties": { "search_mode": { "enum": ["off", "after_original", "only"] }, "final_orientation": { "enum": ["original", "reflected"] }, "reflected_source_id": { "type": "string", "maxLength": 128 }, "reflected_path_hash": { "$ref": "#/$defs/sha256" } } },
        "solution": { "type": "object", "additionalProperties": false, "required": ["path", "length", "solved_depth", "validation"], "properties": { "path": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/identifier" } }, "length": { "type": "integer", "minimum": 0, "maximum": 4096 }, "solved_depth": { "type": "integer", "minimum": 0, "maximum": 4096 }, "touch_depth": { "type": "integer", "minimum": 0, "maximum": 4096 }, "validation": { "const": "valid" }, "collection_index": { "type": "integer", "minimum": 0 }, "collection_status": { "enum": ["first", "complete", "capacity_reached"] } } },
        "profile": { "type": "object", "additionalProperties": false, "required": ["requested_beam", "effective_beam", "alignment_delta", "evidence"], "properties": { "requested_beam": { "type": "integer", "minimum": 1 }, "effective_beam": { "type": "integer", "minimum": 1 }, "alignment_delta": { "type": "integer" }, "selected_profile": { "type": "string", "maxLength": 128 }, "evidence": { "type": "string", "minLength": 1, "maxLength": 128 } } },
        "runtime": { "type": "object", "additionalProperties": false, "required": ["touch_bfs_radius", "solution_mode", "max_depth", "max_collected_solutions"], "properties": { "touch_bfs_radius": { "type": "integer", "minimum": 0, "maximum": 16 }, "solution_mode": { "enum": ["first", "collect"] }, "max_depth": { "type": "integer", "minimum": 1, "maximum": 4096 }, "max_collected_solutions": { "type": "integer", "minimum": 1, "maximum": 1000000 } } },
        "model": { "type": "object", "additionalProperties": false, "required": ["filename", "sha256", "format", "manifest"], "properties": { "filename": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" }, "sha256": { "$ref": "#/$defs/sha256" }, "format": { "enum": ["batchnorm-folded", "resmlp-layernorm"] }, "manifest": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } } } },
        "hardware": { "type": "object", "additionalProperties": false, "required": ["gpu_names", "world_size", "total_runtime_ms"], "properties": { "gpu_names": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }, "world_size": { "type": "integer", "minimum": 1, "maximum": 256 }, "total_runtime_ms": { "type": "integer", "minimum": 0 } } },
        "solver_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "submitted_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
